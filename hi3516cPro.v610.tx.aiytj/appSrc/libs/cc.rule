CC              	= $(ARM_PREFIX)gcc
C++             	= $(ARM_PREFIX)g++
LD              	= $(ARM_PREFIX)ld
AR              	= $(ARM_PREFIX)ar
STRIP           	= $(ARM_PREFIX)strip
RANLIB  		    = $(ARM_PREFIX)ranlib
export 						CC C++ LD AR STRIP RANLIB

CFLAGS						?= -g -Wall -O2
CFLAGS                      += -I $(PWD)/main/include
LDFLAGS        		        ?= -lpthread -lm
#CFLAGS						+= -EL
export 						CFLAGS LDFLAGS 

INSTALL_DIR				    = 
export						INSTALL_DIR


