    "acc    0 1 2                     # accelerate, 1X 2X 4X" \
    "LTE {stop|start|restart|at_init} # drv_reset|no_dhcp_start|at_init|hwstat_ok" \
    "env_init                         # " \
    "autocall                         # pdp_active" \
    "fly_reset                        # " \
    "drv_reset                        # with ko rmmod insmod" \
    "fun_reset                        # cfun=0 cfun=1" \
    "pwr [on]|off                     # testing" \
    "iccid_imei_imsi                  # refresh iccid" \
    "detect_sim1                      # sim1" \
    "detect_sim2                      # sim2"  \
    "sim_ready                        # 1,work:0,crash" \
    "sig                              # csq insr rssi rsrp signal Detect" \
    "tac    [l|c]                     # list or check" \
'

alias set_argv_at='set --     \
    "__________________________________ # public"\
    "AT                                 # AT"\
    "AT+CSQ                             # signal"\
    "AT+LSIMDET=1,1                     # sim 卡热插拔检查"\
    "ATE0                               # 禁用回显"\
    "AT&W                               # 保存配置"\
    "AT+CPIN?                           # 检查 sim 卡"\
    "AT+COCSIM=0                        # 失败软重启"\
    "AT+CEREG?                          # +CEREG: 0,1 已附着网络"\
    "AT+CGDCONT?                        # 因为是自动，不需要手动执行设置 APN"\
    "AT+CGDCONT=5,%IP%,%ctnet%          # Define APN"\
    "AT+CGDCONT=5,%IP%                  # Define APN"\
    "AT+CFUN?                           # 0 是飞行模式"\
    "AT+CFUN=1                          # "\
    "AT+CGACT?                          # PDP上下文激活。5,1 表示 cid=5 已经被设置过"\
    "AT+CGACT=1,5                       # "\
    "AT+SYSNV=0,%usbmode%               # check"\
    "AT+SYSNV=1,%usbmode%,5             # ECM"\
    "AT+TRB                             # reboot 4G module"\
    "AT+CGPADDR                         # 从基站分配到的 IP"\
    "AT+TUEINFO                         # User End info"\
    "AT+NETMSG                          # same as TUEINFO, but ugly"\
    "__________________________________ # EC800E"\
    "AT+QCFG=%BAND%                     # 查询 0x1e200000095=TDD:34.38.39.40.41 + FDD:1.3.5.8"\
    "AT+QCFG=%BAND%,0,95                # 锁定 FDD:1.3.5.8"\
    "AT+QCFG=%BAND%,0,1                 # 锁定     FDD:1"\
    "AT+QCFG=%BAND%,0,4                 # 锁定     FDD:3 常用"\
    "AT+QCFG=%BAND%,0,10                # 锁定     FDD:5"\
    "AT+QCFG=%BAND%,0,80                # 锁定     FDD:8 常用"\
    "AT+QCFG=%BAND%,0,1e200000000       # 锁定 TDD:34.38.39.40.41"\
    "AT+QCFG=%BAND%,0,80                # 锁定     TDD:8 常用"\
    "AT+QCFG=%BAND%,0,7FFFFFFFFFFFFFFF  # 解锁"\
    "AT+QENG=%servingcell%              # 小区信息: <RSRQ>,<RSRP>,<RSSI>,<SINR>,<srxlev>"\
    "AT+QENG=%neighbourcell%            # 邻区信息: <EARFCN>,<PCI>,<RSRQ>,<RSRP>,"\
    "AT+ECFREQ=2,<PCI>,<EARFCN>         # 2=锁定, 物理小区标识, 绝对射频信道号"\
    "AT+ECFREQ=0                        # 0=解锁"\
    "___________________________________# YM310-X09C"\
    "AT*BANDIND?                        # 查询当前工作频段 <band>,<Act> *BANDIND: 0, 41, 7"\
    "AT+ECBAND=1,3,5,8,34,38,39,40,41   # 设置频段信息"\
    "AT^SYSINFO                         # ^SYSINFO:<srv_status>,<srv_domain>,<roam_status>,<sys_mode>,<sim_state>,<sys_submode>"\
    "AT+CCED=0,1                        # 小区信息: MCC,MNC,imsi,roamingFlag,bandInfo,bandwidth,dlEarfcn,cellid,rsrp,rsrq,tac,SrxLev,pcid"\
    "AT+CCED=0,2                        # 邻区信息: MCC,MNC,frequency,cellid,rsrp,rsrq,tac,SrxLev,pcid"\
    "__________________________________ # NT35"\
    "AT+VERCTRL?                        # "\
    "AT+VERCTRL=0,1                     # 上电自动激活PDP上下文"\
    "__________________________________ # NT26E"\
    "AT+ECNETDEVCTL?                    # "\
    "AT+ECNETDEVCTL=3,5,1               # 上电自动激活PDP上下文"\
    "AT+ECPCFG?                         # check"\
    "AT+ECPCFG=%usbNet%,1               # ECM"\
    "AT+LRST                            # reboot 4G module"\
'
