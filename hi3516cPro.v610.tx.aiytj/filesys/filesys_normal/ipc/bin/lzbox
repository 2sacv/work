fn_wait_cache_sync()
{
    timeout_cnt=5

    while true; do
        dirty=`awk '/\<Dirty\>/{print $2}' /proc/meminfo`
        write_back=`awk '/\<Writeback\>/{print $2}' /proc/meminfo`
        stat=`cat /sys/block/mtdblock*/stat  | awk 'BEGIN{sum=0} {sum+=$9} END{print sum}'`

        echo "dirty: $dirty, write_back: $write_back, stat: $stat"

        let timeout_cnt--
        [ $timeout_cnt -eq 0 ] && {
            echo "wait cache sync timeout"
            break
        }

        if [ $dirty -gt 0 ] || [ $write_back -gt 0 ] || [ $stat -gt 0 ]; then
            sync
            echo "cache not empty, countdown: $timeout_cnt"
            sleep 1
            continue
        else
            break
        fi
    done
}

fn_wget()
{
    if [ -z "${2}" ]; then
        wget 121.40.104.39:58889/${1} -O - | grep href | sed -e '1,2d'
        return
    fi
    mkdir -p /tmp/bin; cd /tmp/bin;
    wget 121.40.104.39:58889/${1}
    chmod +x ${1##*/}; echo "/tmp/bin/${1##*/} Done"
}

fn_dbg_no_frame()
{
    echo __sns; let i=2; while [ $i -ge 1 ];do let i--; cat /proc/umap/mipi_rx;sleep 1; echo ___ ;done;
    echo __isp; let i=2; while [ $i -ge 1 ];do let i--; cat /proc/umap/isp;sleep 1;echo ___;done;
    echo __enc; let i=2; while [ $i -ge 1 ];do let i--; cat /proc/umap/venc;sleep 1;echo ___;done;
    echo __sys; let i=2; while [ $i -ge 1 ];do let i--; cat /proc/umap/sys; sleep 1;echo ___;done;
}

fn_temp()
{
    temp_value=`bspmd.l 0x1102A008  1 | grep -m 1 '^0000:' | awk '{print $2}'`
    temp_value2=$((0x$temp_value&0x3FF))
    temperature=`echo | awk -v tt=$temp_value2 '{ printf "%.2f", ( (tt - 127) / 784 ) * 165 - 40 }'`
    echo "cpu temperature:$temperature"
}

fn_lzbox()
{
    local_rc='/opt/etc/local.rc'
    lzbox=lzb
    fn_execute "$@"
}

