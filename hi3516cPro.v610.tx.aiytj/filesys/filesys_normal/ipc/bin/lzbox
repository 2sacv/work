    lzbox=jzzz
    fn_execute "$@"
}

fn_fat()
{
    logger -t udev "lzbox fn_fat catch a plug-out"
    for p in /mnt; do
        mountpoint ${p} &&  {
            fuser -m ${p} | xargs -n1 lsof -p | grep ${p}
            fuser -m ${p} -k; sleep .5; umount -f ${p};
            echo "`date`: plug-out $p" >> /opt/log/messages
        }
    done
    return $?
}

