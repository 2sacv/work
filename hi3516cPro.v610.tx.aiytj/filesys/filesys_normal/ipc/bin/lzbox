    WLAN=wlan1 fn_wifictl $@
}

fn_vmstat()
{
    echo _______________ vmstat ______
    top -b -n1 > /tmp/top
    idle=`cat /tmp/top | awk '{ if (NR == 2) { printf "%d" , $8; exit; } }'`

    ps | awk '{if (NR>1 && 0==match($5, "[[]")) print $0}' > /tmp/pids
    cat /tmp/pids
    pids=`awk '{print $1}' /tmp/pids`
    let sum=0
    for i in ${pids}; do
        [ -e "/proc/$i/smaps" ] || continue
        this="`grep Pss /proc/$i/smaps | awk '{total+=$2}; END {print total}'`"
        echo $i: $this
        let sum=sum+this
    done

    echo "App_sum:            $sum"
    grep -E "(MemFree|Buffers|\<Cached|Slab|KernelStack|PageTables)" /proc/meminfo
    cat /proc/buddyinfo

    if [ "${idle:-0}" -gt 10 ]; then
        sed -n '1,3p' /tmp/top
    else
        top -b -d3 -n2
        #toggle code 1014
    fi
    date +%F.%T
}

fn_vm()
{
    case $1 in
    stat|s)  fn_vmstat    ;;
         x)  pmap -x `ps | awk '/[j]co_server/{print $1}'` | sed '/^[0-9]/d' ;;
    drop|d)  sync; echo 3 > /proc/sys/vm/drop_caches    ;;
     cma|c)  cat /sys/class/mstar/msys/dmem    ;;
         *)  top -n1 | sed -n '1,5p'; free;
             echo -n "free+buffer+cache: "
             cat /proc/meminfo | sed -n '2,4p' | awk '{sum=sum+$2} END{print sum}'
             ;;
    esac
}

fn_ap()
{
if test -d /ipc/etc/aigo_amr; then
    case $1 in
    off)
        # dhcpd
        ps | awk '/[u]dhcpd/{print $1}' | while read PID; do kill -9 $PID; done;
        # release
        hostapd_cli -i wlan1 all_sta |\
            awk -F'=' '/dot11RSNAStatsSTAAddress=/{print $2}' |\
            while read MAC; do
                hostapd_cli -i wlan1 disassociate $MAC; sleep .1
            done
        # hostapd
        ps | awk '/[h]ostapd/{print $1}' | while read PID; do kill -9 $PID; done;
        # udhcpd
        ps | awk '/[u]dhcpd/{print $1}' | while read PID; do kill -9 $PID; done;
        ;;
    on)
		on_apssid=$2
        ifconfig wlan1 172.25.0.255 up
        echo "\
        start 172.25.0.20
        end 172.25.0.254
        interface wlan1
        option  lease 864000
        option  subnet 255.255.255.0
        opt     dns     172.25.0.1
        opt     router  172.25.0.1
        opt     wins    172.25.0.1
        option  domain  local
        option  0x08    01020304        # option 8: cookie server IP addr: 1.2.3.4
        " | sed 's/^  *//' > /tmp/udhcpd.conf
        test -f /tmp/hostapd.conf || fn_ap conf $on_apssid
        hostapd -B /tmp/hostapd.conf
        udhcpd -fS /tmp/udhcpd.conf&
        ;;
 reset)
		APSSID=$2
		fn_ap off; fn_ap on $APSSID ;;
    ls) hostapd_cli -i wlan1 all_sta ;;
    bc) fn_bestchn ${2}              ;;
  conf)
		conf_apssid=$2
        CHN=`fn_bestchn bc bc`
       #HALF_MAC=`ifconfig wlan1 | awk -F':' '/HWaddr/{print $6$7}'`
       #deny_mac_file=/tmp/hostapd.deny
        HALF_MAC=`ifconfig wlan1 | awk -F':' '/HWaddr/{print $5$6$7}' | tr -d ' '`
        echo "\
        interface=wlan1
        ctrl_interface=/var/run/hostapd
        driver=nl80211
        wme_enabled=1
        ht_capab=[SHORT-GI-20]
        wpa_pairwise=TKIP
        ssid=${conf_apssid}
        channel=${CHN:-11}
        ieee80211n=1
        hw_mode=g
        wpa_group_rekey=86400" | sed 's/^  *//' > /tmp/hostapd.conf
        echo "${conf_apssid} "
        ;;
list|l) ccli wificfg -act list ;;
show|*)
        echo "Usage:
        lzbox ap {ls|on|off|reset|list|show|bc}     # use CHN from /tmp/bc when the file exist
        "
        hostapd_cli -i wlan1 all_sta
        ;;
    esac
else
    case $1 in
    off)
        # dhcpd
        ps | awk '/[u]dhcpd/{print $1}' | while read PID; do kill -9 $PID; done;
        # release
        hostapd_cli -i wlan1 all_sta |\
            awk -F'=' '/dot11RSNAStatsSTAAddress=/{print $2}' |\
            while read MAC; do
                hostapd_cli -i wlan1 disassociate $MAC; sleep .1
            done
        # hostapd
        ps | awk '/[h]ostapd/{print $1}' | while read PID; do kill -9 $PID; done;
        # udhcpd
        ps | awk '/[u]dhcpd/{print $1}' | while read PID; do kill -9 $PID; done;
        ;;
    on)
        ifconfig wlan1 172.25.0.1 up
        echo "\
        start 172.25.0.20
        end 172.25.0.254
        interface wlan1
        option  lease 864000
        option  subnet 255.255.255.0
        opt     dns     172.25.0.1
        opt     router  172.25.0.1
        opt     wins    172.25.0.1
        option  domain  local
        option  0x08    01020304        # option 8: cookie server IP addr: 1.2.3.4
        " | sed 's/^  *//' > /tmp/udhcpd.conf
        test -f /tmp/hostapd.conf || fn_ap conf
        hostapd -B /tmp/hostapd.conf
        udhcpd -fS /tmp/udhcpd.conf&
        ;;
 reset) fn_ap off; fn_ap on ;;
    ls) hostapd_cli -i wlan1 all_sta ;;
    bc) fn_bestchn ${2}              ;;
  conf)
        CHN=`fn_bestchn bc bc`
       #HALF_MAC=`ifconfig wlan1 | awk -F':' '/HWaddr/{print $6$7}'`
       #deny_mac_file=/tmp/hostapd.deny
        HALF_MAC=`ifconfig wlan1 | awk -F':' '/HWaddr/{print $5$6$7}' | tr -d ' '`
        echo "\
        interface=wlan1
        ctrl_interface=/var/run/hostapd
        driver=nl80211
        wme_enabled=1
        ht_capab=[SHORT-GI-20]
        wpa_pairwise=TKIP
        rsn_pairwise=CCMP
        ssid=HSIPC-${HALF_MAC}
        wpa_passphrase=12345678
        channel=${CHN:-11}
        ieee80211n=1
        hw_mode=g
        wpa=2
        wpa_key_mgmt=WPA-PSK
        wpa_group_rekey=86400" | sed 's/^  *//' > /tmp/hostapd.conf
        echo "HSIPC-${HALF_MAC} 12345678"
        ;;
list|l) ccli wificfg -act list ;;
show|*)
        echo "Usage:
        lzbox ap {ls|on|off|reset|list|show|bc}     # use CHN from /tmp/bc when the file exist
        "
        hostapd_cli -i wlan1 all_sta
        ;;
    esac
fi
}

